# ============================================================================
# ROXX BCE TECHNORITI — Public Frontend Environment Configuration (Example)
# Copy to .env.local for local development and configure in Vercel Dashboard.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or API secrets in REACT_APP_* variables.
# ============================================================================

# Required Supabase public configuration (find in Supabase Dashboard -> Settings -> API)
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional official institutional UPI details override (defaults preserved from Register.jsx)
# Confirm exact institutional payee details before accepting real funds.
REACT_APP_UPI_VPA=bcebhagalpur@upi
REACT_APP_UPI_PAYEE_NAME=Technoriti 2026 BCE

# ============================================================================
# Supabase Edge Function Server Secrets (Set ONLY via `supabase secrets set`
# or Supabase Dashboard -> Edge Functions -> Secrets — NEVER in .env.local for CRA)
# ============================================================================
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# ALLOWED_ORIGINS=https://your-vercel-domain.vercel.app,http://localhost:3000
# UPI_VPA=bcebhagalpur@upi
# UPI_PAYEE_NAME=Technoriti 2026 BCE
# RESEND_API_KEY=re_YOUR_OPTIONAL_RESEND_KEY
# EMAIL_FROM=TECHNORITI '26 <noreply@your-verified-domain.in>
